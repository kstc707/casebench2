{
  "changelog": {
    "folder": "sklearn.utils",
    "type": "fix",
    "mentions": [
      "_weighted_percentile"
    ]
  },
  "questions": [
    {
      "id": "input",
      "prompt": "What input makes the old _weighted_percentile give a wrong answer? Give a concrete example.",
      "points": [
        {
          "id": "average",
          "text": "It happens with average=True.",
          "evidence": {
            "file": "source.md",
            "quote": "Fixed ``_weighted_percentile`` with ``average=True``"
          }
        },
        {
          "id": "zero-before-end",
          "text": "A sample with weight zero just before the end of the array is involved.",
          "evidence": {
            "file": "source.md",
            "quote": "zero-weight samples\n   just before the end of the array are handled correctly."
          }
        },
        {
          "id": "example",
          "text": "Example: values [1, 2, 3] with weights [3, 0, 3].",
          "evidence": {
            "file": "tests.diff",
            "quote": "_weighted_percentile([1, 2, 3], [3, 0, 3], average=True)"
          }
        }
      ]
    },
    {
      "id": "why",
      "prompt": "Why is the fix `>` instead of `>=`? What did the old condition do wrong?",
      "points": [
        {
          "id": "equal-case",
          "text": "The old check also fired when next_index was equal to max_idx, not only past it.",
          "evidence": {
            "file": "fix.diff",
            "quote": "if next_index >= max_idx:"
          }
        },
        {
          "id": "new-condition",
          "text": "The fix only falls back when next_index is beyond the last index.",
          "evidence": {
            "file": "fix.diff",
            "quote": "if next_index > max_idx:"
          }
        },
        {
          "id": "fallback",
          "text": "In that branch the code goes back to the original percentile index.",
          "evidence": {
            "file": "fix.diff",
            "quote": "# use original `percentile_indices` again"
          }
        }
      ]
    },
    {
      "id": "test",
      "prompt": "What does the new test check, and why does that prove the bug is gone?",
      "points": [
        {
          "id": "compare",
          "text": "It compares the result with and without a zero-weight sample: they must be equal.",
          "evidence": {
            "file": "tests.diff",
            "quote": "assert approx(score_without_zeros) == score_with_zeros"
          }
        },
        {
          "id": "baseline",
          "text": "The baseline is [1, 3] with weights [3, 3].",
          "evidence": {
            "file": "tests.diff",
            "quote": "_weighted_percentile([1, 3], [3, 3], average=True)"
          }
        }
      ]
    }
  ]
}
