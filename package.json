{
  "name": "casebench2",
  "private": true,
  "version": "0.1.0",
  "description": "Learn how real open-source projects work, from your first fork to your first merged pull request",
  "scripts": {
    "dev": "pnpm --filter @casebench2/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:pyodide": "RUN_PYODIDE_TESTS=1 vitest run apps/web/lib/runner apps/web/scripts",
    "team:ask": "tsx packages/team-memory/src/ask.ts"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@9.0.0"
}
